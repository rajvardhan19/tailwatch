# Copy only when database work is needed. The CLI does not load .env automatically.
# Local disposable development credentials, never use these in production.
TAILWATCH_DATABASE_URL=postgresql+psycopg://tailwatch:tailwatch@localhost:5432/tailwatch
TAILWATCH_TEST_DATABASE_URL=postgresql+psycopg://tailwatch:tailwatch@localhost:5432/tailwatch_test
# Signed recipient links (verification/unsubscribe). Use a long random secret per deployment;
# rotating it invalidates links already sent. HTTPS is required outside loopback.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# TAILWATCH_LINK_SECRET=
TAILWATCH_PUBLIC_URL=http://127.0.0.1:8765
# Optional: dated entity source used by /companies/resolve ticker lookups.
# TAILWATCH_REFERENCE_SOURCE=
# External email only after an active validated release; never commit real values.
# TAILWATCH_RESEND_API_KEY=
# TAILWATCH_EMAIL_FROM=alerts@your-verified-domain.example
# Live research feeds (research mode only; see docs/runbooks/live-research.md).
# TAILWATCH_SEC_USER_AGENT=Your Org contact@your.domain
# TAILWATCH_LIVE_MANIFEST=config/sources.live.json
# TAILWATCH_LIVE_OBJECTS=.data/sec-objects
# Only for servers bound to 127.0.0.1: render live feeds without an API key.
# TAILWATCH_LIVE_LOCAL_VIEW=1
